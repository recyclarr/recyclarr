<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress XML doc warnings caused by GenerateDocumentationFile (needed for IDE0005) -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <RecyclarrRepositoryRoot>$(RepositoryRoot)</RecyclarrRepositoryRoot>
    <TestDirectory>$(RepositoryRoot)tests\</TestDirectory>
    <GitVersionBaseDirectory>$(RepositoryRoot)</GitVersionBaseDirectory>
    <!-- GitVersion's informational version already ends with the commit sha -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!--<DisableGitVersionTask>true</DisableGitVersionTask>-->
  </PropertyGroup>

  <!-- Repository rules apply everywhere except the analyzer and its tests, which reference it
       directly. -->
  <ItemGroup
    Condition="'$(MSBuildProjectName)' != 'Recyclarr.Analyzers'
      and '$(MSBuildProjectName)' != 'Recyclarr.Analyzers.Tests'"
  >
    <ProjectReference
      Include="$(RepositoryRoot)src/Recyclarr.Analyzers/Recyclarr.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- For only NON-TEST projects -->
  <ItemGroup
    Condition="!$(MSBuildProjectName.EndsWith('Tests'))
      and !$(MSBuildProjectName.EndsWith('TestLibrary'))"
  >
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).TestLibrary" />
    <!-- For NSubstitute -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>


</Project>
