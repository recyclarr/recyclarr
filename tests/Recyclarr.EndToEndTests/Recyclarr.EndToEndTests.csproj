<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Needs Docker, so `dotnet test` skips it: it is not a testing platform application. It still
    builds as a runnable test executable; scripts/run-e2e-tests.sh runs it with `dotnet run`.
  -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>true</GenerateTestingPlatformEntryPoint>
    <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RecyclarrRepositoryRoot</_Parameter1>
      <_Parameter2>$(RecyclarrRepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Refit.Reflection" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Extensions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="TUnit.Engine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Recyclarr.Api.Sonarr\Recyclarr.Api.Sonarr.csproj" />
    <ProjectReference Include="..\..\src\Recyclarr.Api.Radarr\Recyclarr.Api.Radarr.csproj" />
    <ProjectReference Include="..\..\src\Recyclarr.Client\Recyclarr.Client.csproj" />
  </ItemGroup>

</Project>
