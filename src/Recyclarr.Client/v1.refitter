{
  "openApiPath": "../Recyclarr.Server/Recyclarr.Server.json",
  "namespace": "Recyclarr.Client.V1",
  "multipleInterfaces": "ByTag",
  "includePathMatches": ["^/api/v1/.*"],
  "generateContracts": true,
  "useCancellationTokens": true,
  // Status codes carry protocol meaning here: GET sync/jobs/{id} answers 200 when the job is
  // terminal and 202 while it is still running, so callers need the code, not just the body.
  "returnIApiResponse": true,
  // Refitter maps a response body only for status codes 200, 201, 203, and 206
  // (Refitter.Core/Generation/ReturnTypeGenerator.cs). POST sync/jobs answers 202 exclusively, so
  // its body would otherwise be dropped. The key is the operation id produced by OperationIds in
  // Recyclarr.Server; a mismatch degrades silently to an untyped IApiResponse.
  "responseTypeOverride": {
    "SyncCreateJob": "IApiResponse<CreateSyncJobResponse>"
  },
  "trimUnusedSchema": true,
  "operationNameGenerator": "MultipleClientsFromPathSegments",
  "outputFolder": "Generated",
  "outputFilename": "RecyclarrApi.V1.g.cs",
  "codeGeneratorSettings": {
    "generateOptionalPropertiesAsNullable": true,
    "generateNullableReferenceTypes": true
  }
}
