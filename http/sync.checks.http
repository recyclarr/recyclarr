# Unknown status filter
GET {{baseUrl}}/api/v1/sync/jobs?status=bogus

?? status == 400

###

# Unknown trigger filter
GET {{baseUrl}}/api/v1/sync/jobs?trigger=bogus

?? status == 400

###

# Unknown job
GET {{baseUrl}}/api/v1/sync/jobs/00000000-0000-0000-0000-000000000000

?? status == 404

###

# Unknown job
GET {{baseUrl}}/api/v1/sync/jobs/00000000-0000-0000-0000-000000000000/results

?? status == 404

