# @name listSyncJobs
GET {{baseUrl}}/api/v1/sync/jobs

?? status == 200
?? body jobs isArray

###

# @name listSucceededSyncJobs
GET {{baseUrl}}/api/v1/sync/jobs?status=succeeded

?? status == 200

{{response
  const assert = require("assert");

  test("lists only succeeded jobs", () => {
    assert.ok(response.parsedBody.jobs.every(j => j.status === "Succeeded"));
  });
}}

###

# @name listScheduledSyncJobs
GET {{baseUrl}}/api/v1/sync/jobs?trigger=scheduled

?? status == 200

{{response
  const assert = require("assert");

  test("lists only scheduled jobs", () => {
    assert.ok(response.parsedBody.jobs.every(j => j.trigger === "Scheduled"));
  });
}}

