  // Poll state lives in $global: exports from loop iterations do not reach later regions.
  $global.poll = { response: { statusCode: 202 }, attempts: 0, deadline: Date.now() + 60_000 };
}}

###

# @name poll
# @loop while $global.poll.response.statusCode === 202 && $global.poll.attempts < 60 && Date.now() < $global.poll.deadline
# @sleep 1000
GET {{baseUrl}}/api/v1/sync/jobs/{{createSyncJob.id}}

{{response
  const assert = require("assert");

  $global.poll.response = response;
  $global.poll.attempts++;

  test("poll status is accepted", () => {
    assert.ok(
      response.statusCode === 202 || response.statusCode === 200,
      `expected 202 or 200; got ${response.statusCode}`
    );
  });
}}

###

{{
  const assert = require("assert");
  const { response: last } = $global.poll;
  assert.equal(last.statusCode, 200, "sync did not finish within 60 seconds");
  assert.notEqual(last.parsedBody.status, "Failed", "sync job failed");
}}

# @name getSyncJobResults
GET {{baseUrl}}/api/v1/sync/jobs/{{createSyncJob.id}}/results

?? status == 200
?? body id isString

{{response
  // Readability aid: logs the results without empty arrays and objects, recursively.
  // Also hides meaningful empties such as a value change with `current: []`.
  const isEmpty = (v) => Array.isArray(v)
    ? v.length === 0
    : v !== null && typeof v === "object" && Object.keys(v).length === 0;
  const prune = (v) => {
    if (Array.isArray(v)) return v.map(prune);
    if (v === null || typeof v !== "object") return v;
    return Object.fromEntries(
      Object.entries(v).map(([k, x]) => [k, prune(x)]).filter(([, x]) => !isEmpty(x))
    );
  };
  console.log(JSON.stringify(prune(response.parsedBody), null, 2));
}}
