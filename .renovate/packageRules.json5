{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "NuGet package presentation configuration",
      matchDatasources: ["nuget"],
      matchUpdateTypes: ["patch", "minor", "major"],
      prBodyColumns: [
        "Package",
        "Change",
        "Age",
        "Adoption",
        "Passing",
        "Confidence",
        "Pending",
      ],
      minimumReleaseAge: "5 days",
    },
    {
      description: "Built-in .NET lookups; the custom.dotnet-ga datasource handles these instead",
      matchDatasources: ["docker", "dotnet-version"],
      matchPackageNames: ["/^mcr\\.microsoft\\.com/dotnet//", "dotnet-sdk"],
      enabled: false,
    },
    {
      description: "Add changelog URLs for GitHub Actions digest updates",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      prBodyNotes: ["Changelog: {{{changelogUrl}}}"],
    },
    {
      description: [
        "Roslyn for Recyclarr.Analyzers must not exceed the oldest supported compiler and must",
        "match the exact version EF Core Design requires. Upgrade by hand when an EF Core Design",
        "update fails restore on that conflict.",
      ],
      matchDatasources: ["nuget"],
      matchPackageNames: ["Microsoft.CodeAnalysis.CSharp"],
      enabled: false,
    },
  ],
}
