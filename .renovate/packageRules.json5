{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "NuGet package presentation configuration",
      matchDatasources: ["nuget"],
      matchUpdateTypes: ["patch", "minor", "major"],
      prBodyColumns: [
        "Package",
        "Change",
        "Age",
        "Adoption",
        "Passing",
        "Confidence",
        "Pending",
      ],
      minimumReleaseAge: "5 days",
    },
    {
      description: ".NET images are updated through the custom.dotnet-ga datasource instead",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^mcr\\.microsoft\\.com/dotnet//"],
      enabled: false,
    },
    {
      description: "Add changelog URLs for GitHub Actions digest updates",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      prBodyNotes: ["Changelog: {{{changelogUrl}}}"],
    },
  ],
}
