{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      description: "Update GitVersion versionSpec in GitHub Actions workflows",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*versionSpec:\\s*(?<currentValue>.+)",
      ],
    },
    {
      description: "Update TargetFramework in MSBuild props files",
      customType: "regex",
      managerFilePatterns: ["/\\.props$/"],
      matchStrings: [
        "<TargetFramework>net(?<currentValue>\\d+\\.\\d+)</TargetFramework>",
      ],
      depNameTemplate: "dotnet-sdk",
      datasourceTemplate: "custom.dotnet-ga",
    },
    {
      description: "Update dotnet-version input in setup-dotnet action",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/.+\\.ya?ml$/"],
      matchStrings: ["dotnet-version:\\s*(?<currentValue>\\d+\\.\\d+)\\.x"],
      depNameTemplate: "dotnet-sdk",
      datasourceTemplate: "custom.dotnet-ga",
    },
    {
      description: "Update .NET image channel tags in Dockerfile (docker manager is disabled for these)",
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "(?<depName>mcr\\.microsoft\\.com/dotnet/[a-z-]+):(?<currentValue>\\d+\\.\\d+)-",
      ],
      datasourceTemplate: "custom.dotnet-ga",
    },
    {
      description: "Update the .NET SDK major version in mise configuration",
      customType: "regex",
      managerFilePatterns: ["/(^|/)mise\\.toml$/"],
      matchStrings: ['dotnet\\s*=\\s*"(?<currentValue>\\d+)"'],
      depNameTemplate: "dotnet-sdk",
      datasourceTemplate: "custom.dotnet-ga",
      extractVersionTemplate: "^(?<version>\\d+)",
    },
  ],
}
